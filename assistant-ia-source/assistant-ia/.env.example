# Copie ce fichier en « .env » et remplis une clé, pour tester depuis le PC : npm run test:ia
# Power BI ne lit pas ce fichier : dans le rapport, la clé se colle dans Format > Assistant IA > Clé API.
# Ne mets jamais le fichier .env dans Git (il est déjà exclu par .gitignore).

# Clé OpenAI (commence par sk-). Si elle est remplie, c'est elle qui est utilisée.
OPENAI_API_KEY=

# Clé Gemini (commence par AIza), utilisée si la clé OpenAI est vide.
GEMINI_API_KEY=

# Facultatif : forcer un modèle (sinon choix automatique)
MODELE=
