{
    "dataRoles": [
        {
            "displayName": "Colonnes (texte, dates, catégories, identifiants)",
            "name": "colonnes",
            "kind": "Grouping"
        },
        {
            "displayName": "Valeurs (montants, quantités)",
            "name": "valeurs",
            "kind": "Measure"
        }
    ],
    "objects": {
        "ia": {
            "properties": {
                "apiKey": {
                    "type": {
                        "text": true
                    }
                },
                "modele": {
                    "type": {
                        "text": true
                    }
                },
                "exemples": {
                    "type": {
                        "bool": true
                    }
                },
                "maxLignes": {
                    "type": {
                        "integer": true
                    }
                }
            }
        },
        "general": {
            "properties": {
                "filter": {
                    "type": {
                        "filter": true
                    }
                }
            }
        }
    },
    "dataViewMappings": [
        {
            "table": {
                "rows": {
                    "select": [
                        {
                            "for": {
                                "in": "colonnes"
                            }
                        },
                        {
                            "for": {
                                "in": "valeurs"
                            }
                        }
                    ],
                    "dataReductionAlgorithm": {
                        "window": {
                            "count": 30000
                        }
                    }
                }
            }
        }
    ],
    "privileges": [
        {
            "name": "WebAccess",
            "essential": true,
            "parameters": [
                "https://generativelanguage.googleapis.com",
                "https://api.openai.com"
            ]
        }
    ],
    "supportsLandingPage": true,
    "supportsEmptyDataView": true
}